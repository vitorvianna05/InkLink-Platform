{
  "realm": "inklink",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "clientScopes": [
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "profile",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        },
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "config": {
            "claim.name": "name",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "identity.profile.read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      }
    }
  ],
  "clients": [
    {
      "clientId": "inklink-bff",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${INKLINK_BFF_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://localhost:5192/signin-oidc"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://localhost:5192/signout-callback-oidc"
      },
      "protocolMappers": [
        {
          "name": "inklink audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "inklink-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "inklink actor",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "inklink_actor",
            "claim.value": "user",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "defaultClientScopes": [
        "basic",
        "profile"
      ]
    },
    {
      "clientId": "inklink-ios",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "inklink.ios:/oauthredirect"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": ""
      },
      "protocolMappers": [
        {
          "name": "inklink audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "inklink-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "inklink actor",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "inklink_actor",
            "claim.value": "user",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "defaultClientScopes": [
        "basic",
        "profile"
      ]
    },
    {
      "clientId": "inklink-android",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "inklink.android:/oauthredirect"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": ""
      },
      "protocolMappers": [
        {
          "name": "inklink audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "inklink-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "inklink actor",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "inklink_actor",
            "claim.value": "user",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "defaultClientScopes": [
        "basic",
        "profile"
      ]
    },
    {
      "clientId": "inklink-catalog",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${INKLINK_CATALOG_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "optionalClientScopes": [
        "identity.profile.read"
      ],
      "protocolMappers": [
        {
          "name": "inklink audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "inklink-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "inklink actor",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "inklink_actor",
            "claim.value": "service",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "defaultClientScopes": [
        "basic",
        "profile"
      ]
    }
  ],
  "sslRequired": "all",
  "defaultDefaultClientScopes": [
    "basic",
    "profile"
  ]
}
