# Copie para .env.local (ignorado pelo Git) e ajuste ao ambiente.
# Endereço do BFF que o servidor local do website encaminha (/bff, /api e retornos OIDC).
# Desenvolvimento: https://localhost:5192 · Ambiente isolado da P09: https://localhost:5292
INKLINK_BFF_URL=https://localhost:5192
# Certificado e chave PEM confiáveis para servir o website em HTTPS (exigido pelos cookies __Host-).
INKLINK_DEV_CERT=
INKLINK_DEV_KEY=
# PEM confiável do BFF para o proxy Node (não desativa TLS). P09: artifacts/integration/localhost.pem
INKLINK_BFF_CA_CERT=
# Porta do servidor local do website.
INKLINK_WEB_PORT=5173
# Somente local: aceita certificado do BFF não confiável pelo Node (true/false).
INKLINK_BFF_INSECURE=false
