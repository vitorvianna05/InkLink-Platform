{
  "name": "@inklink/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Website React do InkLink (P10), consumindo o backend pelo BFF.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
